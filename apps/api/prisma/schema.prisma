generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(cuid())
  username                 String            @unique
  passwordHash             String?
  email                    String?           @unique
  googleSub                String?           @unique
  displayName              String
  heightCm                 Int?
  startingWeightKg         Decimal?          @db.Decimal(6, 2)
  goalWeightKg             Decimal?          @db.Decimal(6, 2)
  proteinTargetMode        String            @default("automatic")
  manualProteinTargetGrams Int?
  createdAt                DateTime          @default(now())
  programs                 WorkoutProgram[]
  sessions                 WorkoutSession[]
  bodyWeights              BodyWeightEntry[]
  machines                 Machine[]
  authenticators           Authenticator[]
  nutritionEntries         NutritionEntry[]
}

model Exercise {
  id                 String                    @id
  nameEn             String
  nameDe             String
  nameRu             String?
  description        String
  descriptionDe      String?
  descriptionRu      String?
  instructions       String
  instructionsDe     String?
  instructionsRu     String?
  targetMuscles      String[]
  equipmentType      String
  exerciseType       String
  defaultSets        Int
  minReps            Int
  maxReps            Int
  defaultRestSeconds Int
  defaultIncrement   Decimal                   @db.Decimal(6, 2)
  userNotes          String?
  archived           Boolean                   @default(false)
  images             ExerciseImage[]
  templateExercises  WorkoutTemplateExercise[]
  workoutExercises   WorkoutExercise[]
  machines           Machine[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model ExerciseImage {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  path       String
  caption    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
}

model WorkoutProgram {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  name              String
  active            Boolean           @default(false)
  preferredWeekdays Int[]
  templates         WorkoutTemplate[]
  createdAt         DateTime          @default(now())
}

model WorkoutTemplate {
  id        String                    @id @default(cuid())
  programId String
  program   WorkoutProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]
}

model WorkoutTemplateExercise {
  id              String          @id @default(cuid())
  templateId      String
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])
  sortOrder       Int
  sets            Int
  minReps         Int
  maxReps         Int
  restSeconds     Int
  increment       Decimal         @db.Decimal(6, 2)
  measurementUnit String          @default("kg")
  customName      String?
  notes           String?
  lastWeight      Decimal?        @db.Decimal(6, 2)
  lastReps        Int?
  lastRir         Int?

  @@unique([templateId, exerciseId])
}

model Machine {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  exerciseId       String
  exercise         Exercise          @relation(fields: [exerciseId], references: [id])
  name             String
  gym              String?
  manufacturer     String?
  model            String?
  machineNumber    String?
  availableWeights Decimal[]
  weightIncrement  Decimal?          @db.Decimal(6, 2)
  seatSetting      String?
  backrestSetting  String?
  notes            String?
  images           String[]
  archived         Boolean           @default(false)
  workoutExercises WorkoutExercise[]
}

model WorkoutSession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  templateId       String
  template         WorkoutTemplate   @relation(fields: [templateId], references: [id])
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  notes            String?
  status           String            @default("active")
  clientMutationId String            @unique
  exercises        WorkoutExercise[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model WorkoutExercise {
  id                      String         @id @default(cuid())
  sessionId               String
  session                 WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId              String
  exercise                Exercise       @relation(fields: [exerciseId], references: [id])
  machineId               String?
  machine                 Machine?       @relation(fields: [machineId], references: [id])
  sortOrder               Int
  plannedSets             Int
  minReps                 Int
  maxReps                 Int
  restSeconds             Int
  increment               Decimal        @default(2.5) @db.Decimal(6, 2)
  measurementUnit         String         @default("kg")
  customName              String?
  notes                   String?
  lastWeight              Decimal?       @db.Decimal(6, 2)
  lastReps                Int?
  lastRir                 Int?
  exerciseNameSnapshot    String
  machineSettingsSnapshot Json?
  sets                    WorkoutSet[]
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weight            Decimal         @db.Decimal(6, 2)
  reps              Int
  rir               Int?
  completedAt       DateTime        @default(now())
  clientMutationId  String          @unique

  @@unique([workoutExerciseId, setNumber])
}

model BodyWeightEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime
  weight Decimal  @db.Decimal(6, 2)
  notes  String?

  @@unique([userId, date])
}

model NutritionEntry {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt       DateTime
  mealType         String?
  title            String?
  consumedPercent  Decimal            @default(100) @db.Decimal(5, 2)
  fullCalories     Decimal            @db.Decimal(10, 2)
  fullProteinGrams Decimal            @db.Decimal(10, 2)
  fullFatGrams     Decimal            @db.Decimal(10, 2)
  fullCarbsGrams   Decimal            @db.Decimal(10, 2)
  fullFiberGrams   Decimal            @db.Decimal(10, 2)
  calories         Decimal            @db.Decimal(10, 2)
  proteinGrams     Decimal            @db.Decimal(10, 2)
  fatGrams         Decimal            @db.Decimal(10, 2)
  carbsGrams       Decimal            @db.Decimal(10, 2)
  fiberGrams       Decimal            @db.Decimal(10, 2)
  items            NutritionItem[]
  photo            NutritionPhoto?
  analysis         NutritionAnalysis?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId, occurredAt])
}

model NutritionItem {
  id           String         @id @default(cuid())
  entryId      String
  entry        NutritionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name         String
  amountGrams  Decimal?       @db.Decimal(10, 2)
  calories     Decimal        @db.Decimal(10, 2)
  proteinGrams Decimal        @db.Decimal(10, 2)
  fatGrams     Decimal        @db.Decimal(10, 2)
  carbsGrams   Decimal        @db.Decimal(10, 2)
  fiberGrams   Decimal        @db.Decimal(10, 2)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())

  @@index([entryId, sortOrder])
}

model NutritionPhoto {
  id                  String         @id @default(cuid())
  entryId             String         @unique
  entry               NutritionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  storageKey          String         @unique
  thumbnailStorageKey String?
  mimeType            String
  sizeBytes           Int
  width               Int?
  height              Int?
  sha256              String?
  originalDeletedAt   DateTime?
  createdAt           DateTime       @default(now())
}

model NutritionAnalysis {
  id             String                   @id @default(cuid())
  entryId        String                   @unique
  entry          NutritionEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  state          String                   @default("draft")
  provider       String?
  model          String?
  schemaVersion  String?
  assumptions    Json?
  uncertainty    Json?
  analyzedAt     DateTime?
  clarifications NutritionClarification[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model NutritionClarification {
  id          String            @id @default(cuid())
  analysisId  String
  analysis    NutritionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questionKey String
  question    String
  options     Json?
  answer      String?
  required    Boolean           @default(true)
  answeredAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([analysisId])
}

model Authenticator {
  id                   String  @id @default(cuid())
  credentialID         String  @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  userId               String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasskeyChallenge {
  id         String   @id @default(cuid())
  challenge  String
  purpose    String
  userHandle String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
